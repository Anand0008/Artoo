# ============================================================
# Artoo — Local Test Configuration
# Copy this file to .env and fill in every value marked FILL_THIS_IN
# NEVER commit .env to version control
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
LLM_PROVIDER=bedrock

# ── AWS Bedrock ──────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=FILL_THIS_IN
AWS_SECRET_ACCESS_KEY=FILL_THIS_IN
# If you use a named AWS CLI profile instead of keys, uncomment:
# AWS_PROFILE=FILL_THIS_IN

# Model — cross-region inference profile (change region prefix if needed)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_TOKENS=8192
BEDROCK_TEMPERATURE=0.1

# ── Jira ─────────────────────────────────────────────────────
JIRA_URL=https://YOUR_INSTANCE.atlassian.net
JIRA_USERNAME=FILL_THIS_IN
JIRA_API_TOKEN=<redacted>
JIRA_PROJECTS_FILTER=DEV
JIRA_POLL_JQL=project in (DEV) AND status = "To Do" ORDER BY created DESC
JIRA_POLL_INTERVAL_SECONDS=300

# ── Confluence ───────────────────────────────────────────────
CONFLUENCE_URL=https://YOUR_INSTANCE.atlassian.net/wiki
CONFLUENCE_SPACE_KEYS=SD         # Comma-separated SPACE KEYS (not display names)
CONFLUENCE_MAX_PAGES=10

# ── GitHub ───────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=<redacted>
GITHUB_REPO_OWNER=FILL_THIS_IN
GITHUB_REPO_NAME=FILL_THIS_IN
GITHUB_BASE_BRANCH=main
GITHUB_DEFAULT_REVIEWERS=

# ── Persistence ──────────────────────────────────────────────
SQLITE_DB_PATH=data/artoo.db
DB_ECHO=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ACTIVITY_LOG_PATH=logs/activity.jsonl
LLM_LOG_PATH=logs/llm_calls.jsonl

# ── Metrics API ──────────────────────────────────────────────
METRICS_PORT=8080
METRICS_API_KEY=<redacted>
PR_RECONCILE_INTERVAL_SECONDS=3600

# ── Agent Behaviour ──────────────────────────────────────────
REPO_SCOUT_MAX_FILES=20
COMPLETENESS_THRESHOLD=0.35
LLM_PARSE_RETRY_COUNT=3

# ── Safety ───────────────────────────────────────────────────
# true  = no Jira comments posted, no GitHub PRs created (safe to test)
# false = live run — will post to Jira and create real GitHub PRs
DRY_RUN=false
